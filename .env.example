# Docker 배포 설정 (이 파일을 복사해서 .env 로 만드세요)
# ARTEX_TAG 는 docker-compose 가 받는 상류(원본) 이미지 autumn27/artex 의 태그입니다.
# 다만 이 이미지는 현재 Docker Hub 에서 내려가 받을 수 없어(2026-10-09 확인),
# docker compose up 이 이미지 pull 에서 실패합니다.
# 한국어판 화면·출력을 보려면 README "소스에서 단일 바이너리 컴파일" 경로로 빌드하세요.
ARTEX_TAG=latest
POSTGRES_USER=artex
POSTGRES_PASSWORD=change-me-please
POSTGRES_DB=artex

# LLM (둘 중 하나만 또는 둘 다 입력하세요. 비워 두고 나중에 UI 에서 설정해도 됩니다)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
ARTEX_LLM_PROVIDER=
ARTEX_LLM_MODEL=
ARTEX_LLM_BASE_URL=
ARTEX_LLM_PROXY=

# 첫 실행 보호 (관리자 계정 원격 선점 방지)
# - 웹/API 포트는 기본적으로 호스트의 127.0.0.1 에만 게시됩니다. 다른 기기에서 직접
#   접속해야 하면 ARTEX_BIND=0.0.0.0 으로 바꾸되, 초기 설정을 먼저 마치십시오.
# - 처음 기동하면 로그에 무작위 설정 토큰이 찍히고(docker compose logs artex),
#   /setup 화면에서 그 값을 입력해야 관리자 비밀번호를 만들 수 있습니다.
#   ARTEX_SETUP_TOKEN 을 지정하면 그 값이 토큰이 되고 로그에는 찍히지 않습니다.
# - ARTEX_ADMIN_PASSWORD 를 지정하면 /setup 없이 그 값으로 바로 초기화합니다(8자 이상).
ARTEX_BIND=127.0.0.1
ARTEX_SETUP_TOKEN=
ARTEX_ADMIN_PASSWORD=
# 브라우저 교차 출처(CORS) 허용 목록(쉼표 구분). 내장 UI 는 동일 출처라 비워 둡니다.
ARTEX_CORS_ORIGINS=

# 서버 쪽 기본 출력 언어(ko·en·zh·es). 비우면 한국어입니다. 에이전트 리포트·요약·대화 응답,
# 서버 오류 메시지, 콘솔 로그에 적용되고, 실행 중에는 설정 화면의 "표시 언어"가 우선합니다.
# 웹 화면 문구의 언어는 브라우저마다 설정 화면에서 고릅니다(기본 한국어).
ARTEX_LANG=
